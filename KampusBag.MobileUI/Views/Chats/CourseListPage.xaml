<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KampusBag.MobileUI.ViewModels"
             xmlns:m="clr-namespace:KampusBag.MobileUI.Models"
             xmlns:converters="clr-namespace:KampusBag.MobileUI.Converters"
             x:Class="KampusBag.MobileUI.Views.Chats.CourseListPage"
             Title="Derslerim"
             BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#0D1117}"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:CourseListViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="➕" Clicked="OnCreateCourseClicked"
                     IsEnabled="{Binding CanCreateCourse}"/>
    </ContentPage.ToolbarItems>

    <!-- Tek bir kök Grid kullanıyoruz -->
    <Grid>
        <Grid RowDefinitions="Auto, Auto, *">

            <!-- ── BAŞLIK ── -->
            <Grid Grid.Row="0" BackgroundColor="#1B305E" Padding="20,18,20,20">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Aktif Derslerim"
                           FontSize="22" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Kayıtlı olduğun tüm ders grupları"
                           FontSize="13" TextColor="#A8C8EA"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ── ARAMA ── -->
            <Border Grid.Row="1"
                    Margin="16,12,16,4" Padding="0"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <SearchBar Placeholder="Ders veya hoca adı ara..."
                           PlaceholderColor="#9CA3AF"
                           TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                           BackgroundColor="Transparent"
                           HeightRequest="46"
                           Text="{Binding SearchText}"/>
            </Border>

            <!-- ── ANA İÇERİK ── -->
            <Grid Grid.Row="2">
                <!-- Yükleniyor -->
                <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="#1B305E" WidthRequest="36" HeightRequest="36"/>
                    <Label Text="Dersler yükleniyor..." TextColor="#6B7280" FontSize="14"/>
                </VerticalStackLayout>

                <!-- Hata -->
                <VerticalStackLayout IsVisible="{Binding HasError}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center" Spacing="14" Padding="30">
                    <Label Text="⚠️" FontSize="44" HorizontalOptions="Center"/>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#DC2626" HorizontalTextAlignment="Center" FontSize="14"/>
                    <Button Text="Tekrar Dene"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="#1B305E" TextColor="White" CornerRadius="10"/>
                </VerticalStackLayout>

                <!-- Liste -->
                <CollectionView ItemsSource="{Binding Courses}"
                                SelectionMode="None"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertBool}}"
                                Margin="0,4">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center" Spacing="12" Margin="30">
                            <Label Text="📚" FontSize="52" HorizontalOptions="Center"/>
                            <Label Text="Kayıtlı ders bulunamadı"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#374151, Dark=White}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Bir derse katılmak için kodu kullanın."
                                   FontSize="13" TextColor="#9CA3AF"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:CourseModel">
                            <Grid Padding="16,5">
                                <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D333B}"
                                        StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="16" ColumnSpacing="14">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{Binding TypeColor}"
                                                Stroke="Transparent"
                                                WidthRequest="52" HeightRequest="52">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding AvatarInitial}"
                                                   FontSize="22" FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#111827, Dark=White}" MaxLines="2"/>
                                            <Label Text="{Binding AcademicName}" FontSize="12" TextColor="#6B7280"/>
                                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                                <Border Padding="7,3" Stroke="Transparent" BackgroundColor="{Binding TypeColor}" Opacity="0.1">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding TypeLabel}" FontSize="10" FontAttributes="Bold" TextColor="{Binding TypeColor}"/>
                                                </Border>
                                                <Label Text="{Binding MemberText}" FontSize="11" TextColor="#9CA3AF" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="›" FontSize="28" TextColor="#D1D5DB" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnCourseTapped"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- FAB (Floating Action Button): En dış Grid içinde ama en sonda -->
        <Button Text="+ Derse Katıl"
                Clicked="OnJoinCourseClicked"
                BackgroundColor="#1B305E"
                TextColor="White"
                CornerRadius="28"
                HeightRequest="56"
                Padding="20,0"
                FontAttributes="Bold"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,28"
                ZIndex="1"/>
    </Grid>
</ContentPage>