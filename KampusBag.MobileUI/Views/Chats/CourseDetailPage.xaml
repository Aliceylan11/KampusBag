<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KampusBag.MobileUI.ViewModels"
             xmlns:m="clr-namespace:KampusBag.MobileUI.Models"
             x:Class="KampusBag.MobileUI.Views.Chats.CourseDetailPage"
             x:Name="detailPage"
             BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#0D1117}"
             Shell.NavBarIsVisible="False">

    <!-- ══════════════════════════════════════════════════════════════
         BAŞLIK
    ══════════════════════════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0"
              BackgroundColor="{Binding CourseTypeColor}"
              Padding="20,48,20,24">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

                <!-- Geri + Başlık + Sohbet Butonu -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="←"
                            TextColor="White" BackgroundColor="Transparent"
                            FontSize="22" WidthRequest="44"
                            Clicked="OnBackClicked"/>
                    <Label Grid.Column="1"
                           Text="{Binding Course.Name}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="Black" VerticalOptions="Center"
                           LineBreakMode="TailTruncation"/>
                    <Border Grid.Column="2"
                            BackgroundColor="#FFF" Stroke="Transparent"
                            WidthRequest="44" HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenChatClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="💬" FontSize="20"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Ders Kodu + Tip -->
                <HorizontalStackLayout Grid.Row="1" Spacing="10">
                    <Border BackgroundColor="#FFF" Stroke="Transparent" Padding="10,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Course.CourseCode}"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="Black" CharacterSpacing="2"/>
                    </Border>
                    <Border BackgroundColor="#FFF" Stroke="Transparent" Padding="10,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding CourseTypeLabel}"
                               FontSize="12" TextColor="Black"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- Hoca + Üye Sayısı -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding Course.AcademicName}"
                           FontSize="13" TextColor="#FFFFFFCC"/>
                    <Label Grid.Column="1"
                           Text="{Binding MemberCountText}"
                           FontSize="13" TextColor="#FFFFFFCC"
                           HorizontalOptions="End"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             İÇERİK
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- Yükleniyor -->
            <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                 VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="#1B305E" WidthRequest="36" HeightRequest="36"/>
                <Label Text="Üyeler yükleniyor..."
                       TextColor="#6B7280" FontSize="14" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Hata -->
            <VerticalStackLayout IsVisible="{Binding HasError}"
                                 VerticalOptions="Center" HorizontalOptions="Center"
                                 Spacing="14" Padding="30">
                <Label Text="⚠️" FontSize="44" HorizontalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#DC2626" HorizontalTextAlignment="Center" FontSize="14"/>
                <Button Text="Tekrar Dene"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#1B305E" TextColor="White"
                        CornerRadius="10" HeightRequest="46"/>
            </VerticalStackLayout>

            <!-- Liste -->
            <Grid RowDefinitions="Auto,*"
                  IsVisible="{Binding IsLoading, Converter={StaticResource InvertBool}}">

                <!-- Arama -->
                <Border Grid.Row="0" Margin="16,12,16,6" Padding="0"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <SearchBar Placeholder="İsim veya e-posta ara..."
                               PlaceholderColor="#9CA3AF"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                               BackgroundColor="Transparent"
                               HeightRequest="46"
                               Text="{Binding SearchText}"/>
                </Border>

                <!-- Üye listesi -->
                <RefreshView Grid.Row="1"
                             Command="{Binding RefreshCommand}"
                             RefreshColor="#1B305E">
                    <CollectionView ItemsSource="{Binding Members}"
                                    SelectionMode="None"
                                    Margin="0,4">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="10" Margin="30,40">
                                <Label Text="👥" FontSize="48" HorizontalOptions="Center"/>
                                <Label Text="Üye bulunamadı"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#374151, Dark=White}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:CourseMemberModel">
                                <Grid Padding="16,5">
                                    <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D333B}"
                                            StrokeThickness="1"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14"/>
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              Padding="14" ColumnSpacing="12">

                                            <!-- Avatar -->
                                            <Border Grid.Column="0"
                                                    BackgroundColor="#1B305E" Stroke="Transparent"
                                                    WidthRequest="48" HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="24"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding AvatarInitial}"
                                                       FontSize="20" FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Ad + Rol -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                 VerticalOptions="Center" Spacing="3">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="15" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                                       MaxLines="1"/>
                                                <Label Text="{Binding Email}"
                                                       FontSize="11" TextColor="#9CA3AF" MaxLines="1"/>
                                                <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                                    <Border BackgroundColor="#EEF2FF" Stroke="Transparent" Padding="7,3">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="{Binding RoleLabel}"
                                                               FontSize="10" FontAttributes="Bold" TextColor="#4338CA"/>
                                                    </Border>
                                                    <Border IsVisible="{Binding IsRepresentative}"
                                                            BackgroundColor="#FEF3C7" Stroke="Transparent" Padding="7,3">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="✅ Temsilci"
                                                               FontSize="10" FontAttributes="Bold" TextColor="#92400E"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- DÜZELTME: AncestorType → x:Reference detailPage
                                                 Fiziksel Android'de AncestorType CollectionView
                                                 içinde buton görünmez yapıyor. -->
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{Binding RepresentativeColor}"
                                                    Stroke="Transparent"
                                                    VerticalOptions="Center"
                                                    Padding="10,6"
                                                    IsVisible="{Binding Source={x:Reference detailPage},
                                                                        Path=BindingContext.CanManageRepresentatives}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference detailPage},
                                                                          Path=BindingContext.AssignRepresentativeCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding RepresentativeLabel}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"/>
                                            </Border>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
