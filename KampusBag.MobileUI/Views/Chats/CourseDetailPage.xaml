<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KampusBag.MobileUI.ViewModels"
             xmlns:m="clr-namespace:KampusBag.MobileUI.Models"
             xmlns:cv="clr-namespace:KampusBag.MobileUI.Converters"
             x:Class="KampusBag.MobileUI.Views.Chats.CourseDetailPage"
             x:DataType="vm:CourseDetailViewModel"
             BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#0D1117}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <cv:InvertBoolConverter x:Key="InvertBool" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0"
              BackgroundColor="{Binding CourseTypeColor}"
              Padding="20,48,20,24">

            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="12">

                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="←"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            FontSize="24"
                            WidthRequest="44"
                            Clicked="OnBackClicked"/>

                    <Label Grid.Column="1"
                           Text="{Binding Course.Name}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"/>

                    <Border Grid.Column="2"
                            BackgroundColor="#30FFFFFF"
                            Stroke="Transparent"
                            WidthRequest="44" HeightRequest="44">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenChatClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="💬" FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <HorizontalStackLayout Grid.Row="1" Spacing="8">
                    <Border BackgroundColor="#40000000" Stroke="Transparent" Padding="10,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Course.CourseCode}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="White" CharacterSpacing="1"/>
                    </Border>

                    <Border BackgroundColor="#40000000" Stroke="Transparent" Padding="10,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding CourseTypeLabel}"
                               FontSize="11" TextColor="White"/>
                    </Border>
                </HorizontalStackLayout>

                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0"
                           Text="{Binding Course.AcademicName}"
                           FontSize="14" TextColor="#EEEEEE"/>
                    <Label Grid.Column="1"
                           Text="{Binding MemberCountText}"
                           FontSize="14" TextColor="#EEEEEE"
                           HorizontalOptions="End"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">

            <VerticalStackLayout IsVisible="{Binding IsLoading}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="#1B305E"
                                   WidthRequest="40" HeightRequest="40"/>
                <Label Text="Üyeler senkronize ediliyor..."
                       TextColor="#6B7280" FontSize="14"/>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasError}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="15" Padding="40">
                <Label Text="⚠️" FontSize="50" HorizontalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#DC2626" HorizontalTextAlignment="Center"/>
                <Button Text="Yeniden Dene"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#1B305E" CornerRadius="12"/>
            </VerticalStackLayout>

            <Grid RowDefinitions="Auto, *" 
                  IsVisible="{Binding IsLoading, Converter={StaticResource InvertBool}}">

                <Border Grid.Row="0" Margin="16,15,16,8" Padding="5,0"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <SearchBar Placeholder="Üye ara..."
                               Text="{Binding SearchText}"
                               BackgroundColor="Transparent"
                               HeightRequest="45"/>
                </Border>

                <RefreshView Grid.Row="1"
                             Command="{Binding RefreshCommand}"
                             IsRefreshing="{Binding IsLoading}"
                             RefreshColor="#1B305E">

                    <CollectionView ItemsSource="{Binding Members}"
                                    SelectionMode="None"
                                    Margin="0,5">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" 
                                                 HorizontalOptions="Center" 
                                                 Margin="0,50" Spacing="10">
                                <Label Text="👥" FontSize="60" HorizontalOptions="Center"/>
                                <Label Text="Henüz kimse yok" FontSize="16" FontAttributes="Bold"
                                       TextColor="#9CA3AF" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:CourseMemberModel">
                                <Grid Padding="16,6">
                                    <Border StrokeThickness="0.5"
                                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2D333B}"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15"/>
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="12" ColumnSpacing="12">

                                            <Border Grid.Column="0"
                                                    BackgroundColor="#F3F4F6"
                                                    WidthRequest="48" HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="24"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding AvatarInitial}"
                                                       TextColor="#1B305E" FontAttributes="Bold"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="15" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                                                <Label Text="{Binding Email}" FontSize="12" TextColor="#6B7280"/>

                                                <HorizontalStackLayout Spacing="5" Margin="0,3,0,0">
                                                    <Label Text="{Binding RoleLabel}" FontSize="10" 
                                                           TextColor="#4338CA" BackgroundColor="#EEF2FF"
                                                           Padding="5,2" FontAttributes="Bold"/>
                                                    <Label Text="Temsilci" FontSize="10" 
                                                           IsVisible="{Binding IsRepresentative}"
                                                           TextColor="#92400E" BackgroundColor="#FEF3C7"
                                                           Padding="5,2" FontAttributes="Bold"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Border Grid.Column="2"
                                                    BackgroundColor="{Binding RepresentativeColor}"
                                                    Padding="12,6" VerticalOptions="Center"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CourseDetailViewModel}}, Path=CanManageRepresentatives}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CourseDetailViewModel}}, Path=AssignRepresentativeCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding RepresentativeLabel}" 
                                                       TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>