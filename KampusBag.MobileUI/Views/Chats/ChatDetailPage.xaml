<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:KampusBag.MobileUI.Models"
             x:Class="KampusBag.MobileUI.Views.Chats.ChatDetailPage"
             BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#0D1117}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── BAŞLIK BARI ── -->
        <Grid Grid.Row="0" BackgroundColor="#1B305E" Padding="16,12">
            <Grid ColumnDefinitions="*, Auto">

                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="ChatTitleLabel"
                           FontSize="17" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="{Binding RightsText}"
                           FontSize="11" TextColor="#A8C8EA"
                           IsVisible="{Binding ShowEmergencyButton}"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        Padding="10,4"
                        BackgroundColor="#FFFFFF20"
                        Stroke="Transparent"
                        IsVisible="{Binding IsReadOnly}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Label Text="🔒 Sadece Oku" FontSize="11" TextColor="White"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ── MESAJ LİSTESİ ── -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesList"
                        ItemsSource="{Binding Messages}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        Margin="12,8">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="10">
                    <Label Text="💬" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="İlk mesajı gönderin!"
                           TextColor="#9CA3AF" FontSize="13"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:MessageModel">
                    <VerticalStackLayout Padding="0,3">

                        <!-- ── ACİL MESAJ ── -->
                        <Border IsVisible="{Binding ShowEmergencyBadge}"
                                BackgroundColor="#FFEBEE"
                                Stroke="#D32F2F"
                                StrokeThickness="1.5"
                                Padding="12,10"
                                Margin="0,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="#D32F2F" Stroke="Transparent" Padding="8,3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="🚨 ACİL MESAJ"
                                               FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                    <Label Text="{Binding TimeText}"
                                           FontSize="11" TextColor="#9CA3AF" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding SenderName}"
                                       FontSize="12" FontAttributes="Bold" TextColor="#D32F2F"/>
                                <Label Text="{Binding Content}"
                                       FontSize="14" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ── NORMAL MESAJ ── -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ShowEmergencyBadge,
                                Converter={StaticResource InvertBool}}"
                            HorizontalOptions="{Binding BubbleAlignment}"
                            Margin="0,1">

                            <Border BackgroundColor="{Binding BubbleColor}"
                                    Stroke="Transparent"
                                    Padding="12,8"
                                    MaximumWidthRequest="280">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding SenderName}"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#A8C8EA"
                                           IsVisible="{Binding IsMine,
                                               Converter={StaticResource InvertBool}}"/>
                                    <Label Text="🌙 Sessiz gönderildi"
                                           FontSize="10" TextColor="#9CA3AF"
                                           IsVisible="{Binding ShowSilentBadge}"/>
                                    <Label Text="{Binding Content}"
                                           FontSize="14"
                                           TextColor="{Binding TextColor}"
                                           LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding TimeText}"
                                           FontSize="10"
                                           TextColor="{Binding TextColor}"
                                           Opacity="0.6"
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ── GİRİŞ ALANI ── -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                StrokeThickness="0.5"
                Padding="12,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">

                <!-- Acil Butonu -->
                <Border Grid.Column="0"
                        BackgroundColor="#D32F2F" Stroke="Transparent"
                        WidthRequest="46" HeightRequest="46"
                        IsVisible="{Binding ShowEmergencyButton}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="23"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendEmergencyCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="🚨" FontSize="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Metin Girişi -->
                <Border Grid.Column="1"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                        BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1F2937}"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Entry x:Name="MessageEntry"
                           Text="{Binding MessageText}"
                           Placeholder="{Binding IsReadOnly,
                               Converter={StaticResource ReadOnlyPlaceholder}}"
                           IsEnabled="{Binding IsReadOnly,
                               Converter={StaticResource InvertBool}}"
                           TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="Transparent"
                           HeightRequest="46"
                           Margin="14,0"
                           ReturnCommand="{Binding SendCommand}"/>
                </Border>

                <!-- Gönder -->
                <Border Grid.Column="2"
                        BackgroundColor="{Binding CanSend,
                            Converter={StaticResource BoolToSendColor}}"
                        Stroke="Transparent"
                        WidthRequest="46" HeightRequest="46">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="23"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding IsSending,
                               Converter={StaticResource BoolToSendIcon}}"
                           FontSize="18"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="White"/>
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
