<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:KampusBag.MobileUI.Models"
             x:Class="KampusBag.MobileUI.Views.Chats.ChatDetailPage"
             BackgroundColor="{AppThemeBinding Light=#F0F2F5, Dark=#0D1117}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── BAŞLIK BARI ── -->
        <Grid Grid.Row="0"
              BackgroundColor="#1B305E"
              Padding="16,12">
            <Grid ColumnDefinitions="*, Auto">

                <VerticalStackLayout Grid.Column="0" Spacing="1">
                    <Label x:Name="ChatTitleLabel"
                           Text="Sohbet"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="White"/>
                    <Label x:Name="RightsLabel"
                           Text="{Binding RightsText}"
                           FontSize="11" TextColor="#A8C8EA"
                           IsVisible="{Binding ShowEmergencyButton}"/>
                </VerticalStackLayout>

                <!-- Salt Okunur Rozeti (Frame yerine Border) -->
                <Border Grid.Column="1"
                        Padding="10,4"
                        BackgroundColor="#FFFFFF20"
                        Stroke="Transparent"
                        IsVisible="{Binding IsReadOnly}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Label Text="🔒 Sadece Oku" FontSize="11" TextColor="White"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ── MESAJ LİSTESİ ── -->
        <CollectionView Grid.Row="1"
                        x:Name="MessagesList"
                        ItemsSource="{Binding Messages}"
                        Margin="12,8">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="10">
                    <Label Text="💬" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Henüz mesaj yok. İlk mesajı siz gönderin!"
                           TextColor="#9CA3AF" FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:MessageModel">
                    <VerticalStackLayout Padding="0,4">

                        <!-- ── ACİL MESAJ (HATA BURADAYDI: Border ve StrokeThickness düzeltildi) ── -->
                        <Border IsVisible="{Binding ShowEmergencyBadge}"
                                BackgroundColor="#FFEBEE"
                                Stroke="#D32F2F"
                                StrokeThickness="1.5"
                                Padding="12,10"
                                Margin="0,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="#D32F2F"
                                            Stroke="Transparent"
                                            Padding="8,3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="🚨 ACİL MESAJ"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="White"/>
                                    </Border>
                                    <Label Text="{Binding TimeText}"
                                           FontSize="11" TextColor="#9CA3AF"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding SenderName}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="#D32F2F"/>
                                <Label Text="{Binding Content}"
                                       FontSize="14"
                                       TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ── NORMAL MESAJ ── -->
                        <HorizontalStackLayout
                            IsVisible="{Binding ShowEmergencyBadge,
                                Converter={StaticResource InvertBool}}"
                            HorizontalOptions="{Binding BubbleAlignment}">

                            <Border BackgroundColor="{Binding BubbleColor}"
                                   Stroke="Transparent"
                                   Padding="12,8"
                                   MaximumWidthRequest="280">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding SenderName}"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#1B305E"
                                           IsVisible="{Binding IsMine,
                                               Converter={StaticResource InvertBool}}"/>

                                    <Label Text="🌙 Sessiz gönderildi"
                                           FontSize="10" TextColor="#9CA3AF"
                                           IsVisible="{Binding ShowSilentBadge}"/>

                                    <Label Text="{Binding Content}"
                                           FontSize="14"
                                           TextColor="{Binding TextColor}"
                                           LineBreakMode="WordWrap"/>

                                    <Label Text="{Binding TimeText}"
                                           FontSize="10"
                                           TextColor="{Binding TextColor}"
                                           Opacity="0.6"
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ── GİRİŞ ALANI ── -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#161B22}"
                StrokeThickness="0"
                Padding="12,10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8">

                <Button Grid.Column="0"
                        Text="🚨"
                        BackgroundColor="#D32F2F"
                        TextColor="White"
                        WidthRequest="46" HeightRequest="46"
                        CornerRadius="23"
                        FontSize="18"
                        IsVisible="{Binding ShowEmergencyButton}"
                        Command="{Binding SendEmergencyCommand}"/>

                <!-- Giriş Alanı Çerçevesi -->
                <Border Grid.Column="1"
                       Padding="0"
                       Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                       BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1F2937}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Entry x:Name="MessageEntry"
                           Text="{Binding MessageText}"
                           Placeholder="{Binding IsReadOnly,
                               Converter={StaticResource ReadOnlyPlaceholder}}"
                           IsEnabled="{Binding IsReadOnly,
                               Converter={StaticResource InvertBool}}"
                           TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="Transparent"
                           HeightRequest="46"
                           Margin="14,0"
                           ReturnCommand="{Binding SendCommand}"/>
                </Border>

                <Button Grid.Column="2"
                        Text="➤"
                        BackgroundColor="#1B305E"
                        TextColor="White"
                        WidthRequest="46" HeightRequest="46"
                        CornerRadius="23"
                        FontSize="18"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding CanSend}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding IsSending}"
                                     Value="True">
                            <Setter Property="Text" Value="⏳"/>
                            <Setter Property="BackgroundColor" Value="#6B7280"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentPage>