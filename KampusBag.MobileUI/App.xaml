<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KampusBag.MobileUI"
             x:Class="KampusBag.MobileUI.App"
             xmlns:converters="clr-namespace:KampusBag.MobileUI.Converters"
             Shell.NavBarIsVisible="False"> 

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter Kayıtları -->
            <converters:InvertBoolConverter          x:Key="InvertBool"/>
            <converters:ReadOnlyPlaceholderConverter x:Key="ReadOnlyPlaceholder"/>
            <converters:BoolToSendIconConverter      x:Key="BoolToSendIcon"/>
            <converters:BoolToSendColorConverter     x:Key="BoolToSendColor"/>
            <converters:BoolToColorConverter         x:Key="BoolToColor"/>

        </ResourceDictionary>
    </Application.Resources> 
</Application>
